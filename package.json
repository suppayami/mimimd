{
	"name": "@suppayami/mimimd",
	"type": "module",
	"version": "0.1.0",
	"packageManager": "pnpm@12.6.0",
	"description": "A local Markdown reading server",
	"bin": {
		"mimimd": "dist/cli.js"
	},
	"files": [
		"dist",
		"docs/theme-attribution.md"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build:server": "tsc -p tsconfig.server.json",
		"build": "pnpm build:server && vite build",
		"dev": "pnpm build && node dist/cli.js",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"chokidar": "^6.0.0",
		"dompurify": "^3.4.17",
		"hast-util-to-text": "^4.0.3",
		"hono": "^4.13.16",
		"katex": "^0.19.1",
		"mermaid": "^12.2.0",
		"rehype-katex": "^7.0.1",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.6.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"vue": "~3.5.44",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^10.0.0",
		"@playwright/test": "^1.64.1",
		"@testing-library/vue": "^8.1.0",
		"@types/hast": "^3.0.5",
		"@types/katex": "^0.16.8",
		"@types/node": "^24.19.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "^27.4.0",
		"oxfmt": "^0.75.0",
		"playwright": "1.64.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vue-tsc": "^3.3.14"
	}
}
